{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "Receive_Payment_Batch": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "payments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Payment identifier"
                  },
                  "amount": {
                    "type": "number",
                    "description": "Payment amount"
                  }
                },
                "required": ["id", "amount"]
              }
            }
          },
          "required": ["payments"]
        }
      }
    }
  },
  "actions": {
    "Initialize_Results_Array": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ProcessingResults",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {}
    },
    "Process_Each_Payment": {
      "type": "Foreach",
      "foreach": "@triggerBody()?['payments']",
      "actions": {
        "Initialize_Payment_Result": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "CurrentPaymentResult",
                "type": "object",
                "value": {
                  "paymentId": "@{items('Process_Each_Payment')?['id']}",
                  "amount": "@{items('Process_Each_Payment')?['amount']}",
                  "status": "Processing",
                  "timestamp": "@utcNow()"
                }
              }
            ]
          },
          "runAfter": {}
        },
        "Check_For_Duplicate_Payment": {
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['SFS-Custom-Connectors']['connectionId']"
              }
            },
            "method": "post",
            "path": "/api/CheckDuplicate",
            "body": {
              "paymentId": "@items('Process_Each_Payment')?['id']",
              "amount": "@items('Process_Each_Payment')?['amount']"
            }
          },
          "runAfter": {
            "Initialize_Payment_Result": ["Succeeded"]
          }
        },
        "Check_If_Duplicate": {
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@body('Check_For_Duplicate_Payment')?['isDuplicate']",
                  true
                ]
              }
            ]
          },
          "actions": {
            "Log_Duplicate_Payment_Skipped": {
              "type": "Compose",
              "inputs": {
                "logType": "DUPLICATE",
                "paymentId": "@items('Process_Each_Payment')?['id']",
                "amount": "@items('Process_Each_Payment')?['amount']",
                "message": "Payment already posted - skipping",
                "duplicateCheck": "@body('Check_For_Duplicate_Payment')",
                "timestamp": "@utcNow()"
              },
              "runAfter": {}
            },
            "Set_Payment_As_Skipped": {
              "type": "SetVariable",
              "inputs": {
                "name": "CurrentPaymentResult",
                "value": {
                  "paymentId": "@items('Process_Each_Payment')?['id']",
                  "amount": "@items('Process_Each_Payment')?['amount']",
                  "status": "SKIPPED",
                  "reason": "Duplicate payment",
                  "duplicateCheck": "@body('Check_For_Duplicate_Payment')",
                  "timestamp": "@utcNow()"
                }
              },
              "runAfter": {
                "Log_Duplicate_Payment_Skipped": ["Succeeded"]
              }
            }
          },
          "else": {
            "actions": {
              "Enrich_Account_Data": {
                "type": "ApiConnection",
                "inputs": {
                  "host": {
                    "connection": {
                      "name": "@parameters('$connections')['SFS-Custom-Connectors']['connectionId']"
                    }
                  },
                  "method": "post",
                  "path": "/api/EnrichAccount",
                  "body": {
                    "paymentId": "@items('Process_Each_Payment')?['id']"
                  }
                },
                "runAfter": {}
              },
              "Validate_Payment_Rules": {
                "type": "ApiConnection",
                "inputs": {
                  "host": {
                    "connection": {
                      "name": "@parameters('$connections')['SFS-Custom-Connectors']['connectionId']"
                    }
                  },
                  "method": "post",
                  "path": "/api/ValidatePayment",
                  "body": {
                    "paymentId": "@items('Process_Each_Payment')?['id']",
                    "amount": "@items('Process_Each_Payment')?['amount']",
                    "balance": "@body('Enrich_Account_Data')?['balance']",
                    "status": "@body('Enrich_Account_Data')?['status']",
                    "closedToPosting": "@body('Enrich_Account_Data')?['closedToPosting']"
                  }
                },
                "runAfter": {
                  "Enrich_Account_Data": ["Succeeded"]
                }
              },
              "Check_Validation_Result": {
                "type": "If",
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@body('Validate_Payment_Rules')?['isValid']",
                        true
                      ]
                    }
                  ]
                },
                "actions": {
                  "Log_Payment_Approved": {
                    "type": "Compose",
                    "inputs": {
                      "logType": "VALID",
                      "paymentId": "@items('Process_Each_Payment')?['id']",
                      "amount": "@items('Process_Each_Payment')?['amount']",
                      "message": "Payment approved for posting",
                      "paymentType": "@body('Validate_Payment_Rules')?['paymentType']",
                      "validation": "@body('Validate_Payment_Rules')",
                      "account": "@body('Enrich_Account_Data')",
                      "timestamp": "@utcNow()"
                    },
                    "runAfter": {}
                  },
                  "Set_Payment_As_Approved": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "CurrentPaymentResult",
                      "value": {
                        "paymentId": "@items('Process_Each_Payment')?['id']",
                        "amount": "@items('Process_Each_Payment')?['amount']",
                        "status": "APPROVED_FOR_POSTING",
                        "paymentType": "@body('Validate_Payment_Rules')?['paymentType']",
                        "validation": "@body('Validate_Payment_Rules')",
                        "account": "@body('Enrich_Account_Data')",
                        "timestamp": "@utcNow()"
                      }
                    },
                    "runAfter": {
                      "Log_Payment_Approved": ["Succeeded"]
                    }
                  }
                },
                "else": {
                  "actions": {
                    "Log_Payment_Rejected": {
                      "type": "Compose",
                      "inputs": {
                        "logType": "INVALID",
                        "paymentId": "@items('Process_Each_Payment')?['id']",
                        "amount": "@items('Process_Each_Payment')?['amount']",
                        "message": "Payment rejected - validation errors",
                        "errors": "@body('Validate_Payment_Rules')?['errors']",
                        "paymentType": "@body('Validate_Payment_Rules')?['paymentType']",
                        "validation": "@body('Validate_Payment_Rules')",
                        "account": "@body('Enrich_Account_Data')",
                        "timestamp": "@utcNow()"
                      },
                      "runAfter": {}
                    },
                    "Set_Payment_As_Rejected": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "CurrentPaymentResult",
                        "value": {
                          "paymentId": "@items('Process_Each_Payment')?['id']",
                          "amount": "@items('Process_Each_Payment')?['amount']",
                          "status": "REJECTED",
                          "errors": "@body('Validate_Payment_Rules')?['errors']",
                          "paymentType": "@body('Validate_Payment_Rules')?['paymentType']",
                          "validation": "@body('Validate_Payment_Rules')",
                          "account": "@body('Enrich_Account_Data')",
                          "timestamp": "@utcNow()"
                        }
                      },
                      "runAfter": {
                        "Log_Payment_Rejected": ["Succeeded"]
                      }
                    }
                  }
                },
                "runAfter": {
                  "Validate_Payment_Rules": ["Succeeded"]
                }
              }
            }
          },
          "runAfter": {
            "Check_For_Duplicate_Payment": ["Succeeded"]
          }
        },
        "Append_Result_To_Array": {
          "type": "AppendToArrayVariable",
          "inputs": {
            "name": "ProcessingResults",
            "value": "@variables('CurrentPaymentResult')"
          },
          "runAfter": {
            "Check_If_Duplicate": ["Succeeded"]
          }
        }
      },
      "runAfter": {
        "Initialize_Results_Array": ["Succeeded"]
      }
    },
    "Return_Processing_Summary": {
      "type": "Response",
      "kind": "Http",
      "inputs": {
        "statusCode": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "totalPayments": "@length(triggerBody()?['payments'])",
          "processedAt": "@utcNow()",
          "results": "@variables('ProcessingResults')"
        }
      },
      "runAfter": {
        "Process_Each_Payment": ["Succeeded"]
      }
    }
  },
  "outputs": {}
}
