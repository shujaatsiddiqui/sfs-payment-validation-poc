{
    "definition": {
        "metadata": {
            "notes": {}
        },
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "When_an_HTTP_request_is_received": {
                "type": "Request",
                "kind": "Http",
                "inputs": {
                    "method": "GET"
                }
            }
        },
        "actions": {
            "Get_Pending_Payments": {
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['sfs-payment-validation']['connectionId']"
                        }
                    },
                    "method": "get",
                    "path": "/api/GetPendingPayments"
                },
                "runAfter": {}
            },
            "Initialize_Results_Array": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "ProcessingResults",
                            "type": "array",
                            "value": []
                        }
                    ]
                },
                "runAfter": {
                    "Get_Pending_Payments": [
                        "Succeeded"
                    ]
                }
            },
            "Process_Each_Payment": {
                "type": "Foreach",
                "foreach": "@body('Get_Pending_Payments')['payments']",
                "actions": {
                    "Check_For_Duplicate_Payment": {
                        "type": "ApiConnection",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['SFS-Custom-Connectors']['connectionId']"
                                }
                            },
                            "method": "post",
                            "body": {
                                "paymentId": "@items('Process_Each_Payment')['id']",
                                "amount": "@items('Process_Each_Payment')['amount']"
                            },
                            "path": "/api/CheckDuplicate"
                        }
                    },
                    "Check_If_Duplicate": {
                        "type": "If",
                        "expression": {
                            "and": [
                                {
                                    "equals": [
                                        "@body('Check_For_Duplicate_Payment')['isDuplicate']",
                                        true
                                    ]
                                }
                            ]
                        },
                        "actions": {
                            "Append_Skipped_Result": {
                                "type": "AppendToArrayVariable",
                                "inputs": {
                                    "name": "ProcessingResults",
                                    "value": {
                                        "paymentId": "@items('Process_Each_Payment')['id']",
                                        "status": "SKIPPED",
                                        "reason": "Duplicate payment",
                                        "timestamp": "@utcNow()"
                                    }
                                }
                            }
                        },
                        "else": {
                            "actions": {
                                "Enrich_Account_Data": {
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['SFS-Custom-Connectors']['connectionId']"
                                            }
                                        },
                                        "method": "post",
                                        "body": {
                                            "paymentId": "@items('Process_Each_Payment')['id']"
                                        },
                                        "path": "/api/EnrichAccount"
                                    }
                                },
                                "Validate_Payment_Rules": {
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['SFS-Custom-Connectors']['connectionId']"
                                            }
                                        },
                                        "method": "post",
                                        "body": {
                                            "paymentId": "@items('Process_Each_Payment')['id']",
                                            "amount": "@items('Process_Each_Payment')['amount']",
                                            "balance": "@body('Enrich_Account_Data')['balance']",
                                            "status": "@body('Enrich_Account_Data')['status']",
                                            "closedToPosting": "@body('Enrich_Account_Data')['closedToPosting']"
                                        },
                                        "path": "/api/ValidatePayment"
                                    },
                                    "runAfter": {
                                        "Enrich_Account_Data": [
                                            "Succeeded"
                                        ]
                                    }
                                },
                                "Append_Validation_Result": {
                                    "type": "AppendToArrayVariable",
                                    "inputs": {
                                        "name": "ProcessingResults",
                                        "value": {
                                            "paymentId": "@items('Process_Each_Payment')['id']",
                                            "amount": "@items('Process_Each_Payment')['amount']",
                                            "status": "@if(equals(body('Validate_Payment_Rules')['isValid'], true), 'APPROVED', 'REJECTED')",
                                            "paymentType": "@body('Validate_Payment_Rules')['paymentType']",
                                            "errors": "@body('Validate_Payment_Rules')['errors']",
                                            "account": "@body('Enrich_Account_Data')",
                                            "timestamp": "@utcNow()"
                                        }
                                    },
                                    "runAfter": {
                                        "Validate_Payment_Rules": [
                                            "Succeeded"
                                        ]
                                    }
                                }
                            }
                        },
                        "runAfter": {
                            "Check_For_Duplicate_Payment": [
                                "Succeeded"
                            ]
                        }
                    }
                },
                "runAfter": {
                    "Initialize_Results_Array": [
                        "Succeeded"
                    ]
                }
            },
            "Return_Processing_Summary": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                    "statusCode": 200,
                    "body": {
                        "totalPayments": "@length(body('Get_Pending_Payments')['payments'])",
                        "processedAt": "@utcNow()",
                        "results": "@variables('ProcessingResults')"
                    }
                },
                "runAfter": {
                    "Process_Each_Payment": [
                        "Succeeded"
                    ]
                }
            }
        },
        "parameters": {
            "$connections": {
                "type": "Object",
                "defaultValue": {}
            }
        }
    },
    "parameters": {
        "$connections": {
            "type": "Object",
            "value": {
                "SFS-Custom-Connectors": {
                    "id": "/subscriptions/ac3ae54a-949c-4d1b-8dce-ca292b11096c/resourceGroups/rg-sfs-payment-validation/providers/Microsoft.Web/customApis/SFS-Payment-Validation",
                    "connectionId": "/subscriptions/ac3ae54a-949c-4d1b-8dce-ca292b11096c/resourceGroups/rg-sfs-payment-validation/providers/Microsoft.Web/connections/sfs-custom-connectors-connection",
                    "connectionName": "sfs-custom-connectors-connection",
                    "connectionProperties": {}
                },
                "sfs-payment-validation": {
                    "id": "/subscriptions/ac3ae54a-949c-4d1b-8dce-ca292b11096c/resourceGroups/rg-sfs-payment-validation/providers/Microsoft.Web/customApis/sfs-payment-validation",
                    "connectionId": "/subscriptions/ac3ae54a-949c-4d1b-8dce-ca292b11096c/resourceGroups/rg-sfs-payment-validation/providers/Microsoft.Web/connections/sfs-custom-connectors-connection",
                    "connectionName": "sfs-custom-connectors-connection",
                    "connectionProperties": {}
                }
            }
        }
    }
}
