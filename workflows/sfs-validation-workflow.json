{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "paymentId": {
              "type": "string",
              "description": "Payment ID to validate",
              "default": "PAY-001"
            },
            "ruleSelection": {
              "type": "string",
              "description": "Which rules to apply",
              "default": "All Rules",
              "enum": [
                "All Rules",
                "BR-005",
                "BR-008"
              ]
            }
          },
          "required": [
            "paymentId"
          ]
        }
      }
    }
  },
  "actions": {
    "Validate_Payment": {
      "type": "ApiConnection",
      "inputs": {
        "host": {
          "connection": {
            "name": "@parameters('$connections')['SFS-Payment-Validation']['connectionId']"
          }
        },
        "method": "post",
        "path": "/api/SfsValidatePayment",
        "body": {
          "paymentId": "@triggerBody()?['paymentId']",
          "ruleSelection": "@triggerBody()?['ruleSelection']"
        }
      },
      "runAfter": {}
    },
    "Response": {
      "type": "Response",
      "kind": "Http",
      "inputs": {
        "statusCode": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "isValid": "@body('Validate_Payment')?['isValid']",
          "errors": "@body('Validate_Payment')?['errors']",
          "paymentId": "@triggerBody()?['paymentId']",
          "validatedAt": "@utcNow()"
        }
      },
      "runAfter": {
        "Validate_Payment": [
          "Succeeded"
        ]
      }
    }
  },
  "outputs": {}
}
