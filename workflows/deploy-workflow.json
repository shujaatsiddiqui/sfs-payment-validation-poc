{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "la-sfs-payment-workflow",
      "metadata": {
        "description": "Name of the Logic App for payment validation workflow"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "centralus"
    },
    "customConnectorName": {
      "type": "string",
      "defaultValue": "SFS-Payment-Validation"
    }
  },
  "variables": {
    "customConnectorId": "[resourceId('Microsoft.Web/customApis', parameters('customConnectorName'))]",
    "connectionName": "sfs-custom-connectors-connection"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('connectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "SFS Custom Connectors Connection",
        "customParameterValues": {},
        "api": {
          "id": "[variables('customConnectorId')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('connectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Receive_Payment_Batch": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "payments": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {"type": "string"},
                          "amount": {"type": "number"}
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "actions": {
            "Initialize_Results_Array": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [{
                  "name": "ProcessingResults",
                  "type": "array",
                  "value": []
                }]
              },
              "runAfter": {}
            },
            "Process_Each_Payment": {
              "type": "Foreach",
              "foreach": "@triggerBody()?['payments']",
              "actions": {
                "Check_For_Duplicate_Payment": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['SFS-Custom-Connectors']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/api/CheckDuplicate",
                    "body": {
                      "paymentId": "@items('Process_Each_Payment')?['id']",
                      "amount": "@items('Process_Each_Payment')?['amount']"
                    }
                  },
                  "runAfter": {}
                },
                "Check_If_Duplicate": {
                  "type": "If",
                  "expression": {
                    "and": [{
                      "equals": ["@body('Check_For_Duplicate_Payment')?['isDuplicate']", true]
                    }]
                  },
                  "actions": {
                    "Append_Skipped_Result": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "ProcessingResults",
                        "value": {
                          "paymentId": "@items('Process_Each_Payment')?['id']",
                          "status": "SKIPPED",
                          "reason": "Duplicate payment",
                          "timestamp": "@utcNow()"
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "Enrich_Account_Data": {
                        "type": "ApiConnection",
                        "inputs": {
                          "host": {
                            "connection": {
                              "name": "@parameters('$connections')['SFS-Custom-Connectors']['connectionId']"
                            }
                          },
                          "method": "post",
                          "path": "/api/EnrichAccount",
                          "body": {
                            "paymentId": "@items('Process_Each_Payment')?['id']"
                          }
                        },
                        "runAfter": {}
                      },
                      "Validate_Payment_Rules": {
                        "type": "ApiConnection",
                        "inputs": {
                          "host": {
                            "connection": {
                              "name": "@parameters('$connections')['SFS-Custom-Connectors']['connectionId']"
                            }
                          },
                          "method": "post",
                          "path": "/api/ValidatePayment",
                          "body": {
                            "paymentId": "@items('Process_Each_Payment')?['id']",
                            "amount": "@items('Process_Each_Payment')?['amount']",
                            "balance": "@body('Enrich_Account_Data')?['balance']",
                            "status": "@body('Enrich_Account_Data')?['status']",
                            "closedToPosting": "@body('Enrich_Account_Data')?['closedToPosting']"
                          }
                        },
                        "runAfter": {
                          "Enrich_Account_Data": ["Succeeded"]
                        }
                      },
                      "Append_Validation_Result": {
                        "type": "AppendToArrayVariable",
                        "inputs": {
                          "name": "ProcessingResults",
                          "value": {
                            "paymentId": "@items('Process_Each_Payment')?['id']",
                            "amount": "@items('Process_Each_Payment')?['amount']",
                            "status": "@if(equals(body('Validate_Payment_Rules')?['isValid'], true), 'APPROVED', 'REJECTED')",
                            "paymentType": "@body('Validate_Payment_Rules')?['paymentType']",
                            "errors": "@body('Validate_Payment_Rules')?['errors']",
                            "account": "@body('Enrich_Account_Data')",
                            "timestamp": "@utcNow()"
                          }
                        },
                        "runAfter": {
                          "Validate_Payment_Rules": ["Succeeded"]
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "Check_For_Duplicate_Payment": ["Succeeded"]
                  }
                }
              },
              "runAfter": {
                "Initialize_Results_Array": ["Succeeded"]
              }
            },
            "Return_Processing_Summary": {
              "type": "Response",
              "kind": "Http",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "totalPayments": "@length(triggerBody()?['payments'])",
                  "processedAt": "@utcNow()",
                  "results": "@variables('ProcessingResults')"
                }
              },
              "runAfter": {
                "Process_Each_Payment": ["Succeeded"]
              }
            }
          }
        },
        "parameters": {
          "$connections": {
            "value": {
              "SFS-Custom-Connectors": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('connectionName'))]",
                "connectionName": "[variables('connectionName')]",
                "id": "[variables('customConnectorId')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppUrl": {
      "type": "string",
      "value": "[listCallbackURL(concat(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '/triggers/Receive_Payment_Batch'), '2019-05-01').value]"
    }
  }
}
