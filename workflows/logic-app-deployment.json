{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "la-sfs-payment-validation",
      "metadata": {
        "description": "Name of the Logic App"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "centralus",
      "metadata": {
        "description": "Location for resources"
      }
    },
    "customConnectorName": {
      "type": "string",
      "defaultValue": "SFS-Payment-Validation",
      "metadata": {
        "description": "Name of the Custom Connector"
      }
    }
  },
  "variables": {
    "customConnectorId": "[resourceId('Microsoft.Web/customApis', parameters('customConnectorName'))]",
    "connectionName": "sfs-payment-validation-connection"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('connectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "SFS Payment Validation Connection",
        "customParameterValues": {},
        "api": {
          "id": "[variables('customConnectorId')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('connectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "manual": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paymentId": {
                      "type": "string",
                      "description": "Payment ID to validate",
                      "default": "PAY-001"
                    },
                    "ruleSelection": {
                      "type": "string",
                      "description": "Which rules to apply",
                      "default": "All Rules",
                      "enum": [
                        "All Rules",
                        "BR-005",
                        "BR-008"
                      ]
                    }
                  },
                  "required": [
                    "paymentId"
                  ]
                }
              }
            }
          },
          "actions": {
            "Validate_Payment": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['SFS-Payment-Validation']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/api/SfsValidatePayment",
                "body": {
                  "paymentId": "@triggerBody()?['paymentId']",
                  "ruleSelection": "@triggerBody()?['ruleSelection']"
                }
              },
              "runAfter": {}
            },
            "Response": {
              "type": "Response",
              "kind": "Http",
              "inputs": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "isValid": "@body('Validate_Payment')?['isValid']",
                  "errors": "@body('Validate_Payment')?['errors']",
                  "paymentId": "@triggerBody()?['paymentId']",
                  "validatedAt": "@utcNow()"
                }
              },
              "runAfter": {
                "Validate_Payment": [
                  "Succeeded"
                ]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "SFS-Payment-Validation": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('connectionName'))]",
                "connectionName": "[variables('connectionName')]",
                "id": "[variables('customConnectorId')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppUrl": {
      "type": "string",
      "value": "[listCallbackURL(concat(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '/triggers/manual'), '2019-05-01').value]"
    },
    "logicAppName": {
      "type": "string",
      "value": "[parameters('logicAppName')]"
    }
  }
}
