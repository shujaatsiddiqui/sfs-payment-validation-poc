{
  "testPayloads": {
    "validPayment": {
      "description": "Test Case 1: Valid payment - should pass all rules",
      "payload": {
        "paymentId": "PAY-001",
        "ruleSelection": "All Rules"
      },
      "expectedResult": {
        "isValid": true,
        "errors": []
      }
    },
    "br005Violation": {
      "description": "Test Case 2: BR-005 violation - zero amount",
      "payload": {
        "paymentId": "PAY-002",
        "ruleSelection": "All Rules"
      },
      "expectedResult": {
        "isValid": false,
        "errors": ["BR-005: Zero Payment Amount"]
      }
    },
    "br008Violation": {
      "description": "Test Case 3: BR-008 violation - account status 93",
      "payload": {
        "paymentId": "PAY-003",
        "ruleSelection": "All Rules"
      },
      "expectedResult": {
        "isValid": false,
        "errors": ["BR-008: Account status 93 blocks posting"]
      }
    },
    "bothViolations": {
      "description": "Test Case 4: Both violations",
      "payload": {
        "paymentId": "PAY-004",
        "ruleSelection": "All Rules"
      },
      "expectedResult": {
        "isValid": false,
        "errors": [
          "BR-005: Zero Payment Amount",
          "BR-008: Account status 93 blocks posting"
        ]
      }
    },
    "specificRuleBR005": {
      "description": "Test Case 5: Test BR-005 only",
      "payload": {
        "paymentId": "PAY-002",
        "ruleSelection": "BR-005"
      },
      "expectedResult": {
        "isValid": false,
        "errors": ["BR-005: Zero Payment Amount"]
      }
    },
    "specificRuleBR008": {
      "description": "Test Case 6: Test BR-008 only",
      "payload": {
        "paymentId": "PAY-003",
        "ruleSelection": "BR-008"
      },
      "expectedResult": {
        "isValid": false,
        "errors": ["BR-008: Account status 93 blocks posting"]
      }
    }
  }
}
