{
  "swagger": "2.0",
  "info": {
    "title": "SFS Payment Validation Connector",
    "description": "Custom connector for SFS payment validation using business rules BR-005 and BR-008",
    "version": "1.0.0",
    "contact": {
      "name": "SFS Payment Validation Team",
      "email": "support@sfs.com"
    }
  },
  "host": "ca-sfs-payment-validation.purpleglacier-ca7d6433.centralus.azurecontainerapps.io",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/SfsValidatePayment": {
      "post": {
        "summary": "Validate SFS Payment",
        "description": "Validates a payment against SFS business rules (BR-005 Zero Payment Amount, BR-008 Account Status 93)",
        "operationId": "SfsValidatePayment",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Payment validation request containing payment ID and rule selection",
            "schema": {
              "$ref": "#/definitions/ValidationRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Validation completed successfully",
            "schema": {
              "$ref": "#/definitions/ValidationResponse"
            }
          },
          "400": {
            "description": "Bad request - Invalid input",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "Payment not found",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ValidationRequest": {
      "type": "object",
      "required": [
        "paymentId"
      ],
      "properties": {
        "paymentId": {
          "type": "string",
          "description": "The unique identifier for the payment to validate",
          "x-ms-summary": "Payment ID",
          "x-ms-visibility": "important"
        },
        "ruleSelection": {
          "type": "string",
          "description": "Which business rules to apply during validation",
          "enum": [
            "All Rules",
            "BR-005",
            "BR-008"
          ],
          "default": "All Rules",
          "x-ms-summary": "Rule Selection",
          "x-ms-visibility": "advanced"
        }
      }
    },
    "ValidationResponse": {
      "type": "object",
      "properties": {
        "isValid": {
          "type": "boolean",
          "description": "Indicates whether the payment passed all validations",
          "x-ms-summary": "Is Valid",
          "x-ms-visibility": "important"
        },
        "errors": {
          "type": "array",
          "description": "List of validation errors (empty if payment is valid)",
          "items": {
            "type": "string"
          },
          "x-ms-summary": "Validation Errors",
          "x-ms-visibility": "important"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "description": "Error message describing what went wrong",
          "x-ms-summary": "Error Message"
        }
      }
    }
  },
  "x-ms-connector-metadata": [
    {
      "propertyName": "Website",
      "propertyValue": "https://sfs-payment-validation.com"
    },
    {
      "propertyName": "Privacy policy",
      "propertyValue": "https://sfs-payment-validation.com/privacy"
    },
    {
      "propertyName": "Categories",
      "propertyValue": "Finance;Business Intelligence"
    }
  ]
}
